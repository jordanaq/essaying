cabal-version:      3.8
name:               haskell-essaying
version:            0.1.0.0
build-type:         Simple

common warnings
  ghc-options:      -Wall
  default-language: GHC2021

executable haskell-essaying
  import:           warnings
  hs-source-dirs:   app, src
  main-is:          Main.hs
  other-modules:
      Essaying.API.V1
    , Essaying.Context
    , Essaying.Handler.Health
    , Essaying.Server
  build-depends:
      base >=4.18 && <5
    , aeson >=2.2
    , bytestring >=0.11
    , containers >=0.6
    , directory >=1.3
    , filepath >=1.4
    , servant >=0.20
    , servant-server >=0.20
    , text >=2.0
    , wai-cors >=0.2
    , wai >=3.2
    , warp >=3.3
    , yaml >=0.11
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite haskell-essaying-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test, src
  main-is:          Main.hs
  other-modules:
      Essaying.Context
    , Essaying.API.V1
    , Essaying.Handler.Health
    , Essaying.Server
  build-depends:
      base >=4.18 && <5
    , aeson >=2.2
    , containers >=0.6
    , HUnit >=1.6
    , http-client >=0.7
    , servant-client >=0.20
    , servant-server >=0.20
    , text >=2.0
    , wai >=3.2
    , warp >=3.3
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
