cabal-version:      3.8
name:               haskell-essaying
version:            0.1.0.0
build-type:         Simple
extra-source-files:
    examples/grade-smoke/BuildGradeRequest.hs
    examples/grade-smoke/README.md
    examples/grade-smoke/workspace/context.json
    examples/grade-smoke/workspace/Religion/essay.md
    examples/grade-smoke/workspace/Religion/prompt.md
    data/sample/context.json
    data/sample/History/context.json
    data/sample/History/French-Revolution/context.json
    test/fixtures/provider/README.md
    test/fixtures/provider/gpt-6.1-sol-prompt-options.response.json
    test/fixtures/provider/gpt-6.1-sol-prompt-options.expected.json
    test/fixtures/provider/gpt-6.1-sol-grade.request.json
    test/fixtures/provider/gpt-6.1-sol-grade.response.json
    test/fixtures/provider/gpt-6.1-sol-grade.expected.json
    test/fixtures/provider/grade-workspace/context.json
    test/fixtures/provider/grade-workspace/Religion/essay.md
    test/fixtures/provider/grade-workspace/Religion/prompt.md

common warnings
  ghc-options:      -Wall
  default-language: GHC2021

executable haskell-essaying
  import:           warnings
  hs-source-dirs:   app, src
  main-is:          Main.hs
  other-modules:
      Essaying.API.V1
    , Essaying.Context
    , Essaying.Handler.Account
    , Essaying.Handler.Ai
    , Essaying.Handler.Context
    , Essaying.Handler.ContextError
    , Essaying.Handler.Health
    , Essaying.Handler.Workspace
    , Essaying.Persistence.Account
    , Essaying.Persistence.Context
    , Essaying.Persistence.Utils
    , Essaying.Persistence.Workspace
    , Essaying.Provider.OpenAiCompatible
    , Essaying.Server
    , Essaying.Storage
    , Essaying.Types.Account
    , Essaying.Types.Ai
    , Essaying.Types.Context
    , Essaying.Types.Health
    , Essaying.Types.Storage
    , Essaying.Types.Workspace
    , Essaying.Utils
  build-depends:
      base >=4.18 && <5
    , aeson >=2.2
    , attoparsec >=0.14
    , attoparsec-aeson >=2.2
    , bytestring >=0.11
    , containers >=0.6
    , directory >=1.3
    , filepath >=1.4
    , http-client >=0.7
    , http-client-tls >=0.3
    , http-types >=0.12
    , servant >=0.20
    , servant-server >=0.20
    , text >=2.0
    , transformers >=0.6
    , wai-cors >=0.2
    , wai-extra >=3.1
    , wai >=3.2
    , warp >=3.3
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite haskell-essaying-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test, src
  main-is:          Main.hs
  other-modules:
      ApiClients
    , AiEndpoints
    , AiTestSupport
    , GradeNormalization
    , GradeProvider
    , GradeFailures
    , ContextAcceptance
    , ProviderRequests
    , ProviderErrors
    , WorkspaceDiscovery
    , ContextErrors
    , ContextHandlers
    , Essaying.Context
    , Essaying.API.V1
    , Essaying.Handler.Account
    , Essaying.Handler.Ai
    , Essaying.Handler.Context
    , Essaying.Handler.ContextError
    , Essaying.Handler.Health
    , Essaying.Handler.Workspace
    , Essaying.Persistence.Account
    , Essaying.Persistence.Context
    , Essaying.Persistence.Utils
    , Essaying.Persistence.Workspace
    , Essaying.Provider.OpenAiCompatible
    , Essaying.Server
    , Essaying.Storage
    , Essaying.Types.Account
    , Essaying.Types.Ai
    , Essaying.Types.Context
    , Essaying.Types.Health
    , Essaying.Types.Storage
    , Essaying.Types.Workspace
    , Essaying.Utils
  build-depends:
      base >=4.18 && <5
    , aeson >=2.2
    , attoparsec >=0.14
    , attoparsec-aeson >=2.2
    , bytestring >=0.11
    , containers >=0.6
    , directory >=1.3
    , filepath >=1.4
    , HUnit >=1.6
    , http-types >=0.12
    , http-client >=0.7
    , http-client-tls >=0.3
    , servant-client >=0.20
    , servant-server >=0.20
    , text >=2.0
    , transformers >=0.6
    , wai >=3.2
    , wai-extra >=3.1
    , warp >=3.3
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
